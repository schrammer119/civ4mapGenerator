{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PlanetSim: Install dev environment",
            "type": "process",
            "command": "pixi",
            "args": [
                "install",
                "-e",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}